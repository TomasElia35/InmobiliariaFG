      "css": ":host{--noche:#07090f;--noche-2:#0e1636;--cobalto:#1d3fa8;--cobalto-osc:#16318a;--rosa:#e88aa0;--rosa-claro:#f6c3cf;--durazno:#ffd9c2;--dia:#fff7ee;--blanco:#fff;--luz:#fff7ee;--luz-suave:#c9d2f5;--tinta:#0b1020;--tinta-suave:#3d4460;--radio:4px;--salida:cubic-bezier(0.16,1,0.3,1);font-family:Archivo,system-ui,sans-serif;font-variant-numeric:tabular-nums}.ds-noche{background:var(--noche);padding:16px;display:flex;justify-content:flex-end}.ds-riel{position:relative;width:40px;height:220px;color:var(--luz)}.ds-linea{position:absolute;left:50%;top:0;bottom:0;width:1px;background:currentColor;opacity:.3}.ds-sol{position:absolute;left:0;right:0;bottom:40%;display:flex;flex-direction:column-reverse;align-items:center;gap:6px}.ds-disco{width:13px;height:13px;border-radius:50%;background:var(--rosa);box-shadow:0 0 0 4px #e88aa033,0 0 18px 4px #e88aa066}.ds-hora{font:700 12px Archivo,system-ui,sans-serif;letter-spacing:.08em;font-variant-numeric:tabular-nums}"
