      "html": "<div class=\"ds-cielo\"><div class=\"ds-horizonte\"></div></div>",
      "css": ":host{--noche:#07090f;--noche-2:#0e1636;--cobalto:#1d3fa8;--cobalto-osc:#16318a;--rosa:#e88aa0;--rosa-claro:#f6c3cf;--durazno:#ffd9c2;--dia:#fff7ee;--blanco:#fff;--luz:#fff7ee;--luz-suave:#c9d2f5;--tinta:#0b1020;--tinta-suave:#3d4460;--radio:4px;--salida:cubic-bezier(0.16,1,0.3,1);font-family:Archivo,system-ui,sans-serif;font-variant-numeric:tabular-nums}.ds-cielo{height:220px;background:linear-gradient(180deg,#0e1636,#16297a 60%,#1d3fa8);position:relative;overflow:hidden}.ds-horizonte{position:absolute;left:0;right:0;bottom:40px;height:1px;background:#fff7ee99}.ds-horizonte::before{content:'';position:absolute;left:0;right:0;bottom:0;height:180px;background:radial-gradient(70% 90% at 50% 100%,#ffd9c2e6 0%,#f3a9b4b3 22%,#e88aa066 42%,#e88aa000 70%),linear-gradient(0deg,#e88aa099 0%,#8a5fae55 30%,#1d3fa800 70%);transform-origin:50% 100%;animation:ds-amanecer 2.8s var(--salida) .15s both}.ds-horizonte::after{content:'';position:absolute;left:0;right:0;top:0;height:2px;background:linear-gradient(90deg,#ffd9c200,#fff7ee 30%,#fff7ee 70%,#ffd9c200);box-shadow:0 0 24px 6px #ffd9c2aa}@keyframes ds-amanecer{from{opacity:0;transform:scaleY(.4)}}@media (prefers-reduced-motion:reduce){.ds-horizonte::before{animation:none}}"
