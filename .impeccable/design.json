      "html": "<div class=\"ds-dia\"><button class=\"ds-btn\">Consultar por WhatsApp</button></div>",
      "css": ":host{--noche:#07090f;--noche-2:#0e1636;--cobalto:#1d3fa8;--cobalto-osc:#16318a;--rosa:#e88aa0;--rosa-claro:#f6c3cf;--durazno:#ffd9c2;--dia:#fff7ee;--blanco:#fff;--luz:#fff7ee;--luz-suave:#c9d2f5;--tinta:#0b1020;--tinta-suave:#3d4460;--radio:4px;--salida:cubic-bezier(0.16,1,0.3,1);font-family:Archivo,system-ui,sans-serif;font-variant-numeric:tabular-nums}.ds-dia{background:var(--dia);padding:24px}.ds-btn{display:inline-flex;align-items:center;justify-content:center;min-height:52px;padding:12px 24px;border:0;border-radius:var(--radio);background:var(--cobalto);color:var(--blanco);font:700 16px Archivo,system-ui,sans-serif;cursor:pointer;transition:background-color .2s,transform .15s var(--salida)}.ds-btn:hover{background:var(--cobalto-osc)}.ds-btn:active{transform:translateY(1px)}.ds-btn:focus-visible{outline:2px solid var(--cobalto);outline-offset:3px}"
    },
