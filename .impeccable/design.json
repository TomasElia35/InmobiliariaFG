      "html": "<div class=\"ds-dia\"><div class=\"ds-mes\"><button class=\"ds-d ds-libre\">12</button><button class=\"ds-d ds-ocup\" disabled><s>13</s></button><button class=\"ds-d ds-ext\">14</button><button class=\"ds-d ds-rango\">15</button><button class=\"ds-d ds-ext\">16</button><button class=\"ds-d ds-libre\">17</button></div></div>",
      "css": ":host{--noche:#07090f;--noche-2:#0e1636;--cobalto:#1d3fa8;--cobalto-osc:#16318a;--rosa:#e88aa0;--rosa-claro:#f6c3cf;--durazno:#ffd9c2;--dia:#fff7ee;--blanco:#fff;--luz:#fff7ee;--luz-suave:#c9d2f5;--tinta:#0b1020;--tinta-suave:#3d4460;--radio:4px;--salida:cubic-bezier(0.16,1,0.3,1);font-family:Archivo,system-ui,sans-serif;font-variant-numeric:tabular-nums}.ds-dia{background:var(--dia);padding:24px}.ds-mes{display:grid;grid-template-columns:repeat(6,48px);gap:4px}.ds-d{aspect-ratio:1.15;min-height:40px;border:1px solid transparent;border-radius:var(--radio);background:transparent;font:600 15px Archivo,system-ui,sans-serif;font-variant-numeric:tabular-nums;cursor:pointer;transition:background-color .15s,border-color .15s}.ds-libre{background:var(--blanco);border-color:#f0c9a8;color:var(--cobalto);font-weight:800}.ds-libre:hover{border-color:var(--cobalto)}.ds-ocup{background:repeating-linear-gradient(-45deg,#f6dbe2 0 5px,#edc3ce 5px 6px);color:#8a5866;cursor:default}.ds-rango{background:#1d3fa81f;border-color:var(--cobalto)}.ds-ext{background:var(--cobalto);border-color:var(--cobalto);color:var(--blanco)}.ds-d:focus-visible{outline:2px solid var(--cobalto);outline-offset:3px}"
